{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clash Zhengl",
  "version": "0.1.1",
  "identifier": "com.clashzhengl.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5273",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Clash Zhengl",
        "width": 940,
        "height": 660,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "skipTaskbar": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --js-flags=--max-old-space-size=128 --renderer-process-limit=1 --disable-gpu-shader-disk-cache --disable-dev-shm-usage"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "轻量级代理客户端",
    "longDescription": "Clash Zhengl — 多订阅管理、自动更新、按延迟自动切换的轻量级 Windows 代理客户端。不含任何节点或订阅，仅管理用户自有的订阅配置。",
    "publisher": "myxiaolizi",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
