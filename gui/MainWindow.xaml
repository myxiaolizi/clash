<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClashZhengl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:ClashZhengl.UI">

    <!-- 根容器：用 Mica 背景时，内容层必须透明才能透出材质 -->
    <Grid x:Name="RootGrid" Background="Transparent">

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />   <!-- 自绘标题栏 -->
            <RowDefinition Height="*" />    <!-- 主体 -->
            <RowDefinition Height="28" />   <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ============================================================
             标题栏：可拖动 + 系统按钮
             用 InputNonClientPointerSource 把这一条设为标题栏区域，
             这样拖动、双击最大化、贴边分屏等系统行为都能正常工作。
             ============================================================ -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 应用图标 + 名称 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="14,0,0,0" Spacing="9">
                <Image Source="ms-appx:///Assets/app-32.png" Width="18" Height="18"
                       x:Name="AppIcon" />
                <TextBlock Text="Clash Zhengl" FontSize="12.5"
                           Foreground="{ThemeResource TextSecondaryBrush}"
                           VerticalAlignment="Center" />
                <Border x:Name="StatusChip" CornerRadius="9" Padding="7,2"
                        Background="{ThemeResource NavSelectedBrush}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusChipText" Text="启动中" FontSize="11"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </Border>
            </StackPanel>

            <!-- 空白可拖拽区 -->
            <Border Grid.Column="1" x:Name="DragArea" Background="Transparent" />

            <!-- 窗口按钮 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" x:Name="CaptionButtons">
                <Button x:Name="BtnMinimize" Click="OnMinimizeClick"
                        Width="46" Height="40" CornerRadius="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="最小化">
                    <FontIcon Glyph="&#xE921;" FontSize="10" />
                </Button>
                <Button x:Name="BtnMaximize" Click="OnMaximizeClick"
                        Width="46" Height="40" CornerRadius="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="最大化">
                    <FontIcon Glyph="&#xE922;" FontSize="10" />
                </Button>
                <Button x:Name="BtnClose" Click="OnCloseClick"
                        Width="46" Height="40" CornerRadius="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="关闭">
                    <FontIcon Glyph="&#xE8BB;" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================================================
             主体：左导航 + 右内容
             ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="{ThemeResource NavBgBrush}"
                    BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,1,0">
                <ListView x:Name="NavList" SelectionMode="Single"
                          SelectionChanged="OnNavSelectionChanged"
                          Background="Transparent" BorderThickness="0"
                          ItemContainerStyle="{StaticResource NavItemStyle}"
                          Padding="0,8,0,0">
                    <ListViewItem Tag="subscriptions" IsSelected="True">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8A5;" FontSize="16"
                                      Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock Text="订阅" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="traffic">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE9D9;" FontSize="16"
                                      Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock Text="流量" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="nodes">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE968;" FontSize="16"
                                      Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock Text="节点" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem Tag="settings">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE713;" FontSize="16"
                                      Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock Text="设置" FontSize="13.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>
            </Border>

            <!-- 右侧内容区：四个页面叠放，靠 Visibility 切换（保留滚动位置） -->
            <Grid Grid.Column="1">
                <ScrollViewer x:Name="PageSubscriptions" Padding="28,22,28,28"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SubscriptionsHost" Spacing="16" />
                </ScrollViewer>

                <ScrollViewer x:Name="PageTraffic" Padding="28,22,28,28"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="TrafficHost" Spacing="16" />
                </ScrollViewer>

                <ScrollViewer x:Name="PageNodes" Padding="28,22,28,28"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NodesHost" Spacing="16" />
                </ScrollViewer>

                <ScrollViewer x:Name="PageSettings" Padding="28,22,28,28"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SettingsHost" Spacing="16" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============================================================
             状态栏
             ============================================================ -->
        <Border Grid.Row="2" Background="{ThemeResource NavBgBrush}"
                BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0">
            <Grid Padding="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="CoreDot" Width="7" Height="7"
                                 Fill="{ThemeResource TextTertiaryBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="CoreStatusText" Text="内核：未启动" FontSize="11.5"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="ProxyStatusText" Text="系统代理：未启用" FontSize="11.5"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="2" x:Name="SpeedText" Text="↑ 0 B/s  ↓ 0 B/s"
                           FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
            </Grid>
        </Border>

        <!-- ============================================================
             启动遮罩：daemon 就绪前挡住内容，避免闪空列表。
             从第 1 行开始，**不遮标题栏**，这样启动中也能看到应用名与窗口按钮。
             ============================================================ -->
        <Grid x:Name="BootOverlay" Grid.Row="1" Grid.ColumnSpan="1"
              Grid.RowSpan="1" Background="{ThemeResource AppBgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="36" Height="36"
                              Foreground="{ThemeResource BrandBrush}" />
                <TextBlock x:Name="BootStatusText" Text="正在启动…"
                           FontSize="13" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>
