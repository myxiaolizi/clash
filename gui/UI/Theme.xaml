<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================================================================
         自定义配色。基于 Win11 Fluent 设计语言的强调色，覆盖系统默认值，
         让浅/深色主题都有一致的品牌感。
         ================================================================== -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- 深色 -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="BrandColor">#4C8DFF</Color>
            <SolidColorBrush x:Key="BrandBrush" Color="#4C8DFF" />
            <SolidColorBrush x:Key="BrandHoverBrush" Color="#5E99FF" />
            <SolidColorBrush x:Key="BrandPressedBrush" Color="#3B7AE6" />

            <SolidColorBrush x:Key="AppBgBrush" Color="#12141A" />
            <SolidColorBrush x:Key="CardBgBrush" Color="#1A1D26" />
            <SolidColorBrush x:Key="CardBgHoverBrush" Color="#22262F" />
            <SolidColorBrush x:Key="DividerBrush" Color="#2A2F3A" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8ECF4" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9BA3B4" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6B7385" />

            <SolidColorBrush x:Key="GoodBrush" Color="#3DD68C" />
            <SolidColorBrush x:Key="OkBrush" Color="#F0C24B" />
            <SolidColorBrush x:Key="SlowBrush" Color="#F59A4B" />
            <SolidColorBrush x:Key="BadBrush" Color="#F0596B" />

            <SolidColorBrush x:Key="NavBgBrush" Color="#0D0F14" />
            <SolidColorBrush x:Key="NavSelectedBrush" Color="#232936" />
        </ResourceDictionary>

        <!-- 浅色 -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="BrandColor">#2563EB</Color>
            <SolidColorBrush x:Key="BrandBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="BrandHoverBrush" Color="#3B7AE6" />
            <SolidColorBrush x:Key="BrandPressedBrush" Color="#1D4ED8" />

            <SolidColorBrush x:Key="AppBgBrush" Color="#F3F5F9" />
            <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBgHoverBrush" Color="#F7F9FC" />
            <SolidColorBrush x:Key="DividerBrush" Color="#E3E7EF" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1D26" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A6272" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8B93A3" />

            <SolidColorBrush x:Key="GoodBrush" Color="#16A34A" />
            <SolidColorBrush x:Key="OkBrush" Color="#CA8A04" />
            <SolidColorBrush x:Key="SlowBrush" Color="#EA580C" />
            <SolidColorBrush x:Key="BadBrush" Color="#DC2626" />

            <SolidColorBrush x:Key="NavBgBrush" Color="#EAEEF5" />
            <SolidColorBrush x:Key="NavSelectedBrush" Color="#DDE4F0" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ==================================================================
         通用尺寸与圆角
         ================================================================== -->
    <CornerRadius x:Key="CardRadius">10</CornerRadius>
    <CornerRadius x:Key="ControlRadius">6</CornerRadius>
    <Thickness x:Key="CardPadding">16</Thickness>

    <!-- ==================================================================
         卡片容器：统一圆角 + 描边，深浅色都用同一个模板
         ================================================================== -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <!-- 页面主标题 -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <!-- 页面副标题 -->
    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 分区标题 -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- 次要说明文字 -->
    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 主按钮（强调色） -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource BrandBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ==================================================================
         导航项样式：左侧竖条高亮 + 悬停底色
         ================================================================== -->
    <Style x:Key="NavItemStyle" TargetType="ListViewItem">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="8,2" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

</ResourceDictionary>
